{
  "name": "app-architect-studio",
  "version": "1.0.0",
  "description": "레이어별 알고리즘·도구를 연결해 앱 구조를 설계하고, 규모·비용·한계·규정을 계산해 설계서로 내보내는 도구",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "vitest run",
    "judge": "tsx engine/cli.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "desktop": "vite build && electron .",
    "installer": "vite build && electron-builder --win --x64"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "1.14.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "productName": "App Architect Studio",
  "build": {
    "appId": "com.jinhangcho.appArchitectStudio",
    "productName": "App Architect Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!**/node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "artifactName": "App-Architect-Studio-Setup-${version}.exe",
      "installerLanguages": [
        "ko_KR"
      ],
      "language": "1042"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jinhangcho-ops",
        "repo": "app-architect-studio",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jinhangcho-ops/app-architect-studio.git"
  }
}

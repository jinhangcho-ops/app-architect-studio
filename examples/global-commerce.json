{
  "name": "샘플 — 글로벌 멀티테넌트 커머스 & 정산 (v2 N-01~N-10, N-01은 프로젝트 자체)",
  "deploy": { "mode": "web" },
  "scale": {
    "users": 200000, "seed": 1, "report_country": "KR", "window_share": 0.8,
    "retention_days": 365, "event_multiplier": 3, "overhead_k": 2,
    "burst": { "share": 0.1, "window_s": 300, "requests": 10 }
  },
  "personas": [
    { "name": "한국 일반", "pattern": "regular", "share": 0.4, "country": "KR" },
    { "name": "일본 적극", "pattern": "active", "share": 0.2, "country": "JP", "action_rates": { "주문": 0.15 } },
    { "name": "미국 일반", "pattern": "regular", "share": 0.25, "country": "US" },
    { "name": "유럽 가끔", "pattern": "occasional", "share": 0.15, "country": "DE" }
  ],
  "target_utilization": 0.7,
  "default_availability": 0.999,
  "cost": { "region": "aws:ap-northeast-2", "storage": "storage", "egress": "egress", "transfer": "transfer-interregion" },
  "growth": { "monthly_rate": 0.08, "months": 24, "lead_months": 3 },
  "optimize": { "priorities": ["가용성", "확장성", "비용"] },
  "recovery": { "survive": "zone", "rto_min": 60, "rpo_min": 60 },
  "nodes": [
    { "id": "N-02", "name": "화이트라벨 웹/앱 (N-02)", "layer": "ui", "primary": "react_next",
      "description": "디자인 토큰 동적 테마, 다국어·다통화, 국가별 결제 수단" },
    { "id": "N-08", "name": "글로벌 Edge·L7 게이트웨이 (N-08)", "layer": "gateway", "primary": "least_connections",
      "extras": ["token_bucket", "cdn_edge"], "replicas": 2, "zones": 2,
      "vars": { "normal": { "service_time_cv": 1.8 }, "event": { "service_time_cv": 1.8 } } },
    { "id": "N-03", "name": "코어 주문 API (N-03)", "layer": "backend", "primary": "api_autoscale",
      "extras": ["transactional_outbox", "idempotency_key"], "replicas": 2, "zones": 2, "region": "aws:ap-northeast-2",
      "perf": { "service_ms": 20, "workers": 8 }, "spec": { "vcpu": 2, "memGb": 1 } },
    { "id": "N-09", "name": "세금·환율 정책 엔진 (N-09)", "layer": "backend", "primary": "spring_boot",
      "extras": ["grpc"], "replicas": 2, "zones": 2, "perf": { "service_ms": 5, "workers": 16 } },
    { "id": "N-04", "name": "Kafka 이벤트 브로커 (N-04)", "layer": "queue", "primary": "kafka", "replicas": 3, "zones": 3, "partitions": 24, "max_lag_s": 60 },
    { "id": "N-05", "name": "멀티마켓 정산 워커 (N-05)", "layer": "batch", "primary": "on_demand_worker", "min_instances": 6, "zones": 3, "perf": { "service_ms": 40, "workers": 4 },
      "vars": { "normal": { "cold_start_s": 20, "max_start_delay_s": 300 }, "event": { "cold_start_s": 20, "max_start_delay_s": 300 } } },
    { "id": "N-06", "name": "정산·원장 DB (N-06)", "layer": "db", "primary": "postgresql",
      "extras": ["range_partitioning", "read_replica", "uuidv7_keys"], "replicas": 2, "zones": 2, "region": "aws:ap-northeast-1",
      "backup": { "every_h": 24, "pitr": true }, "dr": { "region": "aws:ap-northeast-3", "mode": "standby" },
      "privacy": { "personal": true, "subjects": ["KR", "JP"] },
      "spec": { "vcpu": 2, "memGb": 16 },
      "tables": [
        { "name": "orders", "primary_key": ["id"],
          "columns": [
            { "name": "id", "type": "uuid" }, { "name": "tenant_id", "type": "int" }, { "name": "user_id", "type": "bigint" },
            { "name": "currency", "type": "text", "max_length": 3, "avg_bytes": 3 }, { "name": "amount", "type": "numeric" },
            { "name": "status", "type": "text", "max_length": 20, "avg_bytes": 8 }, { "name": "created_at", "type": "timestamp" }
          ],
          "indexes": [{ "name": "idx_tenant_user_time", "columns": ["tenant_id", "user_id", "created_at"] }],
          "partition": { "column": "created_at", "interval": "month" } },
        { "name": "ledger_entries", "primary_key": ["id"], "retention_days": 1825,
          "columns": [
            { "name": "id", "type": "bigint" }, { "name": "order_id", "type": "uuid" }, { "name": "account", "type": "text", "max_length": 32, "avg_bytes": 12 },
            { "name": "debit", "type": "numeric" }, { "name": "credit", "type": "numeric" }, { "name": "fx_rate", "type": "float" },
            { "name": "memo", "type": "text", "max_length": 200, "nullable": true }, { "name": "posted_at", "type": "timestamp" }
          ],
          "indexes": [{ "name": "idx_order", "columns": ["order_id"] }, { "name": "idx_account_time", "columns": ["account", "posted_at"] }] }
      ] },
    { "id": "N-07", "name": "PG·은행 어댑터 허브 (N-07)", "layer": "external", "primary": "async_retry_dlq",
      "extras": ["idempotency_key"], "region": "aws:ap-northeast-2",
      "privacy": { "personal": true, "subjects": ["KR", "JP"], "sends_external": true },
      "vars": { "normal": { "needs_sync_response": false }, "event": { "needs_sync_response": false } } },
    { "id": "N-10", "name": "데이터 레이크하우스 (N-10)", "layer": "analytics", "primary": "databricks", "batch": { "every_min": 60, "window_min": 30 }, "backup": { "every_h": 1 }, "perf": { "service_ms": 2, "workers": 8 },
      "extras": ["iceberg"], "region": "aws:ap-northeast-2",
      "privacy": { "personal": true, "subjects": ["JP"] },
      "tables": [
        { "name": "events", "retention_days": 730,
          "columns": [
            { "name": "event_id", "type": "uuid" }, { "name": "tenant_id", "type": "int" }, { "name": "user_id", "type": "bigint" },
            { "name": "name", "type": "text", "max_length": 64, "avg_bytes": 16 }, { "name": "props", "type": "json", "avg_bytes": 180 },
            { "name": "ts", "type": "timestamp" }
          ],
          "partition": { "column": "ts", "interval": "day" } }
      ] }
  ],
  "actions": [
    { "name": "주문", "per_session": 0.08,
      "writes": [{ "node": "N-06", "table": "orders" }, { "node": "N-06", "table": "ledger_entries", "rows": 2 }, { "node": "N-10", "table": "events", "rows": 3 }] },
    { "name": "상품 조회 기록", "per_session": 6, "writes": [{ "node": "N-10", "table": "events" }] }
  ],
  "edges": [
    { "from": "N-02", "to": "N-08" },
    { "from": "N-08", "to": "N-03" },
    { "from": "N-03", "to": "N-09", "rtt_ms": 1 },
    { "from": "N-03", "to": "N-06" },
    { "from": "N-03", "to": "N-04", "sync": false },
    { "from": "N-04", "to": "N-05", "sync": false },
    { "from": "N-05", "to": "N-06", "carries": "write" },
    { "from": "N-05", "to": "N-07" },
    { "from": "N-04", "to": "N-10", "sync": false }
  ]
}

{
  "name": "행동·테이블 예시 — 3단계 예시 + 주문·리뷰 행동이 orders·order_items·reviews에 쓰기, 데이터 사전·고정장 정산 파일",
  "deploy": {
    "mode": "web"
  },
  "scale": {
    "users": 100000,
    "seed": 1,
    "report_country": "KR",
    "window_share": 0.8,
    "retention_days": 365,
    "event_multiplier": 3,
    "overhead_k": 2,
    "burst": {
      "share": 0.1,
      "window_s": 300,
      "requests": 10
    }
  },
  "personas": [
    {
      "name": "핵심 열성",
      "pattern": "power",
      "share": 0.05,
      "action_rates": {
        "주문": 0.6,
        "리뷰": 0.1
      }
    },
    {
      "name": "열성",
      "pattern": "enthusiast",
      "share": 0.1,
      "action_rates": {
        "주문": 0.4,
        "리뷰": 0.06
      }
    },
    {
      "name": "적극",
      "pattern": "active",
      "share": 0.2,
      "action_rates": {
        "주문": 0.2
      }
    },
    {
      "name": "일반",
      "pattern": "regular",
      "share": 0.3
    },
    {
      "name": "가끔",
      "pattern": "occasional",
      "share": 0.2
    },
    {
      "name": "드물게",
      "pattern": "rare",
      "share": 0.1
    },
    {
      "name": "휴면 직전",
      "pattern": "dormant",
      "share": 0.05
    }
  ],
  "target_utilization": 0.7,
  "default_availability": 0.999,
  "cost": {
    "region": "aws:ap-northeast-2",
    "storage": "storage",
    "egress": "egress",
    "transfer": "transfer-interregion"
  },
  "growth": {
    "monthly_rate": 0.1,
    "months": 24,
    "lead_months": 3
  },
  "nodes": [
    {
      "id": "web",
      "name": "웹 화면",
      "layer": "ui"
    },
    {
      "id": "lb",
      "name": "게이트웨이",
      "layer": "gateway",
      "primary": "least_connections",
      "extras": [
        "token_bucket"
      ],
      "replicas": 2,
      "vars": {
        "normal": {
          "service_time_cv": 1.8
        },
        "event": {
          "service_time_cv": 1.8
        }
      }
    },
    {
      "id": "api",
      "name": "주문 API",
      "layer": "backend",
      "primary": "api_autoscale",
      "perf": {
        "service_ms": 20,
        "workers": 8
      },
      "spec": {
        "vcpu": 2,
        "memGb": 1
      }
    },
    {
      "id": "db",
      "name": "주문 DB",
      "layer": "db",
      "primary": "postgresql",
      "replicas": 2,
      "tables": [
        {
          "name": "orders",
          "columns": [
            {
              "name": "id",
              "type": "uuid",
              "label": "주문 ID"
            },
            {
              "name": "user_id",
              "type": "bigint",
              "label": "회원 번호",
              "personal": true
            },
            {
              "name": "status",
              "type": "text",
              "avg_bytes": 8,
              "label": "주문 상태",
              "domain": "코드",
              "codes": [
                {
                  "code": "P",
                  "label": "결제 대기"
                },
                {
                  "code": "C",
                  "label": "결제 완료"
                },
                {
                  "code": "X",
                  "label": "취소"
                }
              ],
              "default_value": "P"
            },
            {
              "name": "amount",
              "type": "numeric",
              "label": "결제 금액",
              "domain": "금액"
            },
            {
              "name": "created_at",
              "type": "timestamp",
              "label": "주문 시각",
              "default_value": "CURRENT_TIMESTAMP"
            }
          ],
          "primary_key": [
            "id"
          ],
          "indexes": [
            {
              "name": "idx_user_time",
              "columns": [
                "user_id",
                "created_at"
              ]
            }
          ],
          "partition": {
            "column": "created_at",
            "interval": "month"
          },
          "label": "주문",
          "description": "주문 한 건"
        },
        {
          "name": "order_items",
          "columns": [
            {
              "name": "order_id",
              "type": "uuid"
            },
            {
              "name": "line_no",
              "type": "int"
            },
            {
              "name": "sku",
              "type": "text",
              "avg_bytes": 12
            },
            {
              "name": "qty",
              "type": "int"
            },
            {
              "name": "price",
              "type": "numeric"
            }
          ],
          "primary_key": [
            "order_id",
            "line_no"
          ]
        },
        {
          "name": "reviews",
          "columns": [
            {
              "name": "id",
              "type": "bigint"
            },
            {
              "name": "order_id",
              "type": "uuid"
            },
            {
              "name": "body",
              "type": "text",
              "max_length": 2000,
              "avg_bytes": 300
            },
            {
              "name": "created_at",
              "type": "timestamp"
            }
          ],
          "primary_key": [
            "id"
          ],
          "indexes": [
            {
              "name": "idx_order",
              "columns": [
                "order_id"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "worker",
      "name": "정산 워커",
      "layer": "batch",
      "primary": "on_demand_worker",
      "min_instances": 0,
      "vars": {
        "normal": {
          "cold_start_s": 20,
          "max_start_delay_s": 300
        },
        "event": {
          "cold_start_s": 20,
          "max_start_delay_s": 300
        }
      }
    }
  ],
  "edges": [
    {
      "from": "web",
      "to": "lb"
    },
    {
      "from": "lb",
      "to": "api",
      "rtt_ms": 1
    },
    {
      "from": "api",
      "to": "db",
      "rtt_ms": 1
    },
    {
      "from": "worker",
      "to": "db",
      "carries": "write",
      "sync": false,
      "interfaces": [
        {
          "name": "카드사 정산 파일",
          "kind": "file",
          "path": "SETTLE_YYYYMMDD.dat",
          "description": "카드사가 보내는 하루 정산 내역",
          "per_request": 1,
          "on": "all",
          "record": {
            "format": "fixed",
            "delimiter": ",",
            "encoding": "euc-kr",
            "newline": "crlf",
            "header": false
          },
          "request": [
            {
              "name": "record_type",
              "type": "string",
              "required": true,
              "length": 1,
              "description": "D=내역"
            },
            {
              "name": "order_id",
              "type": "string",
              "required": true,
              "length": 36
            },
            {
              "name": "approved_at",
              "type": "datetime",
              "required": true,
              "length": 14,
              "description": "YYYYMMDDhhmmss"
            },
            {
              "name": "amount",
              "type": "integer",
              "required": true,
              "length": 13
            }
          ],
          "tables": [
            {
              "node": "db",
              "table": "orders",
              "op": "read"
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "name": "주문",
      "per_session": 0.1,
      "writes": [
        {
          "node": "db",
          "table": "orders"
        },
        {
          "node": "db",
          "table": "order_items",
          "rows": 3
        }
      ]
    },
    {
      "name": "리뷰",
      "per_session": 0.02,
      "writes": [
        {
          "node": "db",
          "table": "reviews"
        }
      ]
    }
  ]
}
